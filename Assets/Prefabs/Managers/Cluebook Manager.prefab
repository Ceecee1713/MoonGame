    FoundSecondClueFragment: 0
  - ClueText: {fileID: 0}
    FirstClueFragment: {fileID: 11400000, guid: 8e2adbe73ffbfc14b95717f703b03995, type: 2}
    SecondClueFragment: {fileID: 11400000, guid: 23c3f4fe9482bbc4c9ebd931c9f60457, type: 2}
    FullCodedClue: 
    FullDecipheredClue: How your people shows their devotion to the Moon.
    FoundFirstClueFragment: 0
    FoundSecondClueFragment: 0
  - ClueText: {fileID: 0}
    FirstClueFragment: {fileID: 11400000, guid: 7d682adf7a27cfc4db4399e78f4d6eb8, type: 2}
    SecondClueFragment: {fileID: 11400000, guid: ba59ba0d1ff78c148a65fb714859a84f, type: 2}
    FullCodedClue: 
    FullDecipheredClue: What does the Moon witness from humanity?
    FoundFirstClueFragment: 0
    FoundSecondClueFragment: 0
  - ClueText: {fileID: 0}
    FirstClueFragment: {fileID: 11400000, guid: 348e5bde95b9df442b1194c5a8e13908, type: 2}
    SecondClueFragment: {fileID: 11400000, guid: f675338aeb6538a49991a2e91b9c4d00, type: 2}
    FullCodedClue: 
    FullDecipheredClue: 'A statement that''s open about misery wholeheartedly. '
    FoundFirstClueFragment: 0
    FoundSecondClueFragment: 0
  - ClueText: {fileID: 0}
    FirstClueFragment: {fileID: 11400000, guid: b90fbd9366dac054481f8ff1e2e83c42, type: 2}
    SecondClueFragment: {fileID: 11400000, guid: f1991c7afced816419dbeb3b337a6b37, type: 2}
    FullCodedClue: 
    FullDecipheredClue: 'Be transparent with the Moon while making humanity seem
      capable. '
    FoundFirstClueFragment: 0
    FoundSecondClueFragment: 0
  - ClueText: {fileID: 0}
    FirstClueFragment: {fileID: 11400000, guid: 38a3fa902d89dcd4bbdfd48596078af6, type: 2}
    SecondClueFragment: {fileID: 11400000, guid: fa776d549e04f8f4ba5dea9ed83cae48, type: 2}
    FullCodedClue: 
    FullDecipheredClue: 'The Moon always remains in the night sky. She is constant,
      but she knows her powers already. '
    FoundFirstClueFragment: 0
    FoundSecondClueFragment: 0
  - ClueText: {fileID: 0}
    FirstClueFragment: {fileID: 11400000, guid: ad0da430414640048bf4ec26d98b0e81, type: 2}
    SecondClueFragment: {fileID: 11400000, guid: 3a3b4f377c42ed94792df46e35708826, type: 2}
    FullCodedClue: 
    FullDecipheredClue: 'The answer requires no audience, exchange or recognition. '
    FoundFirstClueFragment: 0
    FoundSecondClueFragment: 0
  - ClueText: {fileID: 0}
    FirstClueFragment: {fileID: 11400000, guid: 9ec1234a409dce040b8cff97d5baadca, type: 2}
