%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d3139b830089d814fbd239d3511709d3, type: 3}
  m_Name: MoonStatueTutorial
  m_EditorClassIdentifier: 
  Messages:
  - message: 'You have a set time to explore the forest before the miasma becomes
      too much to handle. '
    uniqueWordsToColour:
    - set time
    wordColour: {r: 1, g: 1, b: 1, a: 1}
  - message: "The Moon Statue may change the speed of how fast Corrosion accumulates,
      but don\u2019t expect your Goddess to listen every time as her power was drained
      dramatically."
    uniqueWordsToColour:
    - change the speed of how fast Corrosion accumulates
    wordColour: {r: 1, g: 1, b: 1, a: 1}
  - message: 'These effects will only last for a day. '
    uniqueWordsToColour: []
    wordColour: {r: 1, g: 1, b: 1, a: 1}
  - message: Interact with The Moon Statue to advance to the next day. Advancing
      to the next day resets your Health to full as well as reset the timer.
    uniqueWordsToColour:
    - resets
    - Health
    - reset the timer
    wordColour: {r: 1, g: 1, b: 1, a: 1}
