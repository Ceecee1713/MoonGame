MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d3139b830089d814fbd239d3511709d3, type: 3}
  m_Name: EndGameDialogue
  m_EditorClassIdentifier: 
  Messages:
  - message: 'After successfully returning all the moon fragments and reforging the
      Ancient Prayer, Moonlight began to cast its light over the treetops like white
      ocean waves. The miasma began to vanish around you as it travelled deeper into
      the shadows of the forest. '
    uniqueWordsToColour: []
    wordColour: {r: 1, g: 1, b: 1, a: 1}
  - message: 'Although the souls of the deceased cannot be brought back to life,
      the newly repaired Moon Full Statue gives you hope. '
    uniqueWordsToColour: []
    wordColour: {r: 1, g: 1, b: 1, a: 1}
  - message: 'Hope that it''s not too late to the save the other villages of your
      once unified civilization before impending darkness devours all. '
    uniqueWordsToColour: []
    wordColour: {r: 1, g: 1, b: 1, a: 1}
  - message: 'It''s lonely having lost all the people you knew, then needing to confront
      them as hollow husks that speak in tongues. '
    uniqueWordsToColour: []
    wordColour: {r: 1, g: 1, b: 1, a: 1}
  - message: There may no longer be anymore priestesses for all you know.
    uniqueWordsToColour: []
    wordColour: {r: 1, g: 1, b: 1, a: 1}
  - message: The dead may never obtain peace, so now it's your duty to ensure no
      one else ends up in the same position. Quite possibly, as the last priestess...
    uniqueWordsToColour: []
    wordColour: {r: 1, g: 1, b: 1, a: 1}
