%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d3139b830089d814fbd239d3511709d3, type: 3}
  m_Name: StartingGameDialogue
  m_EditorClassIdentifier: 
  Messages:
  - message: 'There was a small quaint village deep in the woods. '
    uniqueWordsToColour: []
    wordColour: {r: 1, g: 1, b: 1, a: 1}
  - message: 'Nature wasn''t kind to these villagers. They had to walk long distances
      for water, and foraging for food proved even more difficult. '
    uniqueWordsToColour: []
    wordColour: {r: 1, g: 1, b: 1, a: 1}
  - message: 'They had no choice but to live here, for a miasmic fog was plaguing
      the land and cornered all inhabitants here. '
    uniqueWordsToColour: []
    wordColour: {r: 1, g: 1, b: 1, a: 1}
  - message: "Fear had taken hold of everyone\u2019s minds and made the people afraid
      of each other. Order collapsed as panic set in. The civilization fell apart
      and everyone began living far away from each other, creating smaller villages
      instead."
    uniqueWordsToColour: []
    wordColour: {r: 1, g: 1, b: 1, a: 1}
  - message: 'No one could explain where the fog came from, but it continued killing
      people, wildlife and rotting plant life. '
    uniqueWordsToColour: []
    wordColour: {r: 1, g: 1, b: 1, a: 1}
  - message: Faced with death, the people had turned to their faith. Their faith
      was in the Moon Goddess.
    uniqueWordsToColour: []
    wordColour: {r: 1, g: 1, b: 1, a: 1}
  - message: People knew that Moonlight could repel the fog. Her light was their
      protection, and everyone built Moon Statues of their own to fight off the miasma.
    uniqueWordsToColour: []
    wordColour: {r: 1, g: 1, b: 1, a: 1}
  - message: "Still, prayers couldn\u2019t save the people, and it\u2019s assumed
      that half of the people had died from the fog. Prayers couldn\u2019t save your
      village either. "
    uniqueWordsToColour: []
    wordColour: {r: 1, g: 1, b: 1, a: 1}
  - message: "Now, you\u2019re the only one left of your village and the last of
      their Moon Priestesses. Desperation clings to your soul as you refuse to make
      peace in death. While you can\u2019t bring them back, you have a fighting chance
      to combat the silent death\u2026"
    uniqueWordsToColour: []
    wordColour: {r: 1, g: 1, b: 1, a: 1}
