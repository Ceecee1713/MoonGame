  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d3139b830089d814fbd239d3511709d3, type: 3}
  m_Name: CorriosonZoneTutorial
  m_EditorClassIdentifier: 
  Messages:
  - message: 'Your people were smart enough to infuse the surrounding lamps with
      Moonlight, but almost all have gone out with the Moon Fragments gone. '
    uniqueWordsToColour: []
    wordColour: {r: 1, g: 1, b: 1, a: 1}
  - message: "If you leave the Moonlight, you\u2019ll begin to accumulate Corrosion.
      Corrosion lowers your Health. Staying in the Moonlight recovers your Health."
    uniqueWordsToColour:
    - leave the Moonlight
    - Corrosion lowers your Health
    - Staying in the Moonlight recovers your Health
    - accumulate Corrosion
    wordColour: {r: 1, g: 1, b: 1, a: 1}
  - message: 'Corrosion will accumulate dramatically once the timer reaches 0. You
      will die if your health drops to 0. '
    uniqueWordsToColour:
    - Corrosion will accumulate dramatically
    - reaches 0
    wordColour: {r: 1, g: 1, b: 1, a: 1}
  - message: 'Some areas of the forest are more toxic than others, so beware. '
    uniqueWordsToColour:
    - 
    wordColour: {r: 1, g: 1, b: 1, a: 1}
  - message: 'Gathering more Moon Fragments increases the range of Moonlight to traverse
      the forest safely and Corrosion will accumulate slower. '
    uniqueWordsToColour:
    - more Moon Fragments increases the range of Moonlight
    - Corrosion will accumulate slower
    wordColour: {r: 1, g: 1, b: 1, a: 1}
  - message: Plan accordingly to navigate through the miasma strategically.
    uniqueWordsToColour: []
    wordColour: {r: 1, g: 1, b: 1, a: 1}
